# ============================================================
# HVAC CRM/ERP Platform - Environment Configuration Template
# Copy this file to .env and fill in your values
# ============================================================

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=hvac_crm
POSTGRES_USER=hvac_admin
POSTGRES_PASSWORD=<CHANGE_ME>
DATABASE_URL=postgresql+asyncpg://hvac_admin:<CHANGE_ME>@postgres:5432/hvac_crm
DATABASE_URL_SYNC=postgresql://hvac_admin:<CHANGE_ME>@postgres:5432/hvac_crm

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- MinIO (S3) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=<CHANGE_ME>
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=hvac-documents
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=<CHANGE_ME>

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<CHANGE_ME>
KEYCLOAK_HOST=keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=hvac
KEYCLOAK_CLIENT_ID=hvac-backend
KEYCLOAK_CLIENT_SECRET=<CHANGE_ME>
KEYCLOAK_FRONTEND_CLIENT_ID=hvac-frontend
KEYCLOAK_URL=http://keycloak:8080

# --- Backend (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_DEBUG=true
SECRET_KEY=<CHANGE_ME>
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# --- MCP Server ---
MCP_HOST=0.0.0.0
MCP_PORT=8001

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=hvac
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=hvac-frontend
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=<CHANGE_ME>

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=

# --- Application ---
APP_NAME=HVAC CRM/ERP Platform
APP_VERSION=0.1.0
LOG_LEVEL=INFO
