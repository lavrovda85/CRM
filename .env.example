# ============================================================
# SPEC CRM/ERP Platform - Environment Configuration Template
# Copy this file to .env and fill in your values
# ============================================================
#
GITHUB_SSH_KEY=
GITHUB_REPO_URL=

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=hvac_crm
POSTGRES_USER=hvac_admin
POSTGRES_PASSWORD=<CHANGE_ME>
DATABASE_URL=postgresql+asyncpg://hvac_admin:<CHANGE_ME>@postgres:5432/hvac_crm
DATABASE_URL_SYNC=postgresql://hvac_admin:<CHANGE_ME>@postgres:5432/hvac_crm

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_SLA_CHECK_EVERY_MINUTES=15
CELERY_OVERDUE_CHECK_EVERY_MINUTES=30
CELERY_TASK_NOTIFICATIONS_SCAN_EVERY_MINUTES=15
CELERY_DAILY_SUMMARY_HOUR=20
CELERY_DAILY_SUMMARY_MINUTE=0
CELERY_MONTHLY_DEPRECIATION_DAY_OF_MONTH=1
CELERY_MONTHLY_DEPRECIATION_HOUR=2
CELERY_MONTHLY_DEPRECIATION_MINUTE=0

# --- MinIO (S3) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=<CHANGE_ME>
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=hvac-documents
MINIO_ENDPOINT=http://minio:9000
# Browser-facing S3 endpoint for presigned download URLs (must be reachable from users' browsers).
# Local dev: http://localhost:9000. Public tunnel via nginx only: https://YOUR_TUNNEL_HOST/storage-s3 (see docker/nginx/nginx.conf).
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=<CHANGE_ME>

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<CHANGE_ME>
# Backend/keycloak-sync use these as fallback for Admin API if hvac-backend service account has no realm-management roles.
KEYCLOAK_HOST=keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=hvac
KEYCLOAK_CLIENT_ID=hvac-backend
KEYCLOAK_CLIENT_SECRET=<CHANGE_ME>
# Optional: must match `iss` inside access tokens if it differs from KEYCLOAK_URL/realms/<realm>.
KEYCLOAK_TOKEN_ISSUER=
KEYCLOAK_FRONTEND_CLIENT_ID=hvac-frontend
KEYCLOAK_URL=http://keycloak:8080

# --- Backend (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_DEBUG=true
# Empty production DB: set true once (create_all + patches); then false. Same DDL as dev without opening debug CORS.
SCHEMA_BOOTSTRAP_ON_STARTUP=false
SECRET_KEY=<CHANGE_ME>
# When Keycloak rejects login: CRM user in PostgreSQL can sign in with DEV_BYPASS_PASSWORD (needs BACKEND_DEBUG=true OR DEV_BYPASS_AUTH=true).
# Docker: add these to your .env — compose passes them into the backend container (see docker-compose services.backend.environment).
DEV_BYPASS_AUTH=false
DEV_BYPASS_PASSWORD=
# true only for tests without Keycloak; fake keycloak_id breaks normal login unless DEV_BYPASS_PASSWORD is set.
KEYCLOAK_SKIP_USER_SYNC=false
# Deploy (Docker): ``keycloak-sync`` runs after API is healthy. Links users.keycloak_id to Keycloak (email/username).
# CRM never stores passwords in PostgreSQL. When set, keycloak-sync sets this password on every active CRM user in Keycloak (create or reset). Remove after first deploy so later runs do not mass-reset passwords.
KEYCLOAK_SYNC_INITIAL_PASSWORD=
# If keycloak-sync logs 403 on Admin API: Realm hvac → Clients → hvac-backend → Service account roles →
# realm-management → query-users, view-users, manage-users. Secret must match KEYCLOAK_CLIENT_SECRET.
# Add your public tunnel origin when demoing to clients, e.g. "https://abc.ngrok-free.app"
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:3500"]

# --- MCP Server ---
MCP_HOST=0.0.0.0
MCP_PORT=8001

# --- Frontend (Next.js) ---
# Where Next.js server proxies /api/v1 (must be reachable FROM the Next process).
# Docker Compose frontend: http://backend:8000 (set automatically in compose if unset).
# Local `npm run dev` on host: http://127.0.0.1:8000
BACKEND_INTERNAL_URL=http://backend:8000
# Browser API base: leave empty to use same-origin /api/v1 (recommended, avoids CORS).
# Or full URL e.g. http://localhost:8000/api/v1 if you call the API directly from the browser.
# Do not bake in a private LAN IP for production — external browsers cannot reach it.
NEXT_PUBLIC_API_URL=
# Leave empty to auto-use wss://current-host/ws (works with ngrok/Cloudflare on port 80). Override only if needed.
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=hvac
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=hvac-frontend
NEXT_PUBLIC_AVATAR_SERVICE_BASE_URL=https://api.dicebear.com/9.x/thumbs/svg
NEXT_PUBLIC_TASK_TIMELINE_HOUR_START=8
NEXT_PUBLIC_TASK_TIMELINE_HOUR_END=20
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=<CHANGE_ME>
# Timeline board: "due soon" threshold in minutes (for warning color in calendar cards)
NEXT_PUBLIC_TASK_DUE_SOON_MINUTES=180

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=

# --- OpenAI (AI assistant: /api/v1/ai-assistant/chat) ---
# Never commit real keys. Rotate keys if exposed.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: route OpenAI API only through Xray sidecar (docker compose service xray-openai).
# Set OPENAI_VLESS_URI to your vless://...&security=reality&... link for the sidecar; keep secrets out of git.
# OPENAI_VLESS_URI=
# OPENAI_HTTP_PROXY=http://xray-openai:10808
#
# --- Admin deploy (server + deploy-agent sidecar; see deploy/server/docker-compose.ip.yml) ---
# GITHUB_SSH_KEY=
# GITHUB_REPO_URL=git@github.com:org/repo.git
# DEPLOY_AGENT_URL=http://deploy-agent:9090
# ADMIN_DEPLOY_ENABLED=false
# DEPLOY_HOST_REPO_PATH=/opt/crm
# IANA timezone for «сегодня»/«завтра» in AI assistant (server clock)
# AI_ASSISTANT_TIMEZONE=Europe/Moscow
# AI_ASSISTANT_MAX_TOOL_ROUNDS=24
YANDEX_GEOCODER_API_KEY=
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# --- Application ---
APP_NAME=SPEC CRM
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# --- Scheduled task auto-create (Celery beat) ---
TASK_SCHEDULER_ENABLED=false
TASK_SCHEDULER_CRON_MINUTE=0
TASK_SCHEDULER_CRON_HOUR=9
TASK_SCHEDULER_CRON_DAY_OF_MONTH=*
TASK_SCHEDULER_CRON_MONTH_OF_YEAR=*
TASK_SCHEDULER_CRON_DAY_OF_WEEK=1-5
TASK_SCHEDULER_TITLE=Daily control task
TASK_SCHEDULER_DESCRIPTION=
TASK_SCHEDULER_PRIORITY=medium
TASK_SCHEDULER_TEMPLATE_ID=
TASK_SCHEDULER_ASSIGNED_TO=
TASK_SCHEDULER_REQUESTED_BY=
TASK_SCHEDULER_BOARD_ID=
TASK_SCHEDULER_CLIENT_ID=
TASK_SCHEDULER_DUE_IN_HOURS=24
TASK_SCHEDULER_OBSERVER_IDS=
TASK_SCHEDULER_CO_ASSIGNEE_IDS=
TASK_SCHEDULER_DEDUP_WINDOW_MINUTES=180

# --- Docker: DNS for services that call the internet (backend, MCP, workers) ---
# If you see "Temporary failure in name resolution" when importing tenders or using AI:
DOCKER_DNS_PRIMARY=8.8.8.8
DOCKER_DNS_SECONDARY=1.1.1.1

# --- MCP / AI: tender import from web (fetch URL + DuckDuckGo search) ---
TENDER_FETCH_TIMEOUT_SECONDS=25
TENDER_FETCH_MAX_BYTES=2000000
TENDER_FETCH_ALLOW_INSECURE_HTTP=false
TENDER_FETCH_ALLOW_PRIVATE_HOSTS=false
# If true (default), when container DNS is broken: resolve via HTTPS to 1.1.1.1 (DoH), then curl --resolve
TENDER_FETCH_DOH_FALLBACK=true
TENDER_SEARCH_MAX_RESULTS=12

# --- Multi-tenancy / testing ---
# Primary test organization (created on startup; all users except Dev Admin are bound here as default).
TESTING_COMPANY_NAME=Спец-строй
TESTING_COMPANY_SLUG=spec-stroy
# Dev Admin: sees every company in GET /companies/mine and may open any tenant via X-Company-Id without membership.
# Comma-separated users.id UUIDs and/or use DEV_ADMIN_EMAILS.
DEV_ADMIN_USER_IDS=
DEV_ADMIN_EMAILS=
