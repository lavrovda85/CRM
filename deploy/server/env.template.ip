# Copy to /opt/crm/.env on the server and replace secrets.
# After updating this file: git pull on server, then: bash deploy/server/first-time-stack.sh /opt/crm
# Replace 192.168.9.17 with your server IP if different.

# --- Public URL (browser + Keycloak redirects) ---
PUBLIC_HOST=192.168.9.17
PUBLIC_ORIGIN=http://192.168.9.17

# --- PostgreSQL ---
POSTGRES_DB=hvac_crm
POSTGRES_USER=hvac_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG
DATABASE_URL=postgresql+asyncpg://hvac_admin:CHANGE_ME_STRONG@postgres:5432/hvac_crm
DATABASE_URL_SYNC=postgresql://hvac_admin:CHANGE_ME_STRONG@postgres:5432/hvac_crm

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG
MINIO_ENDPOINT=http://minio:9000
# Must match nginx /storage-s3/ location (see docker/nginx/nginx.conf).
MINIO_PUBLIC_ENDPOINT=http://${PUBLIC_HOST}/storage-s3
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME_STRONG
MINIO_BUCKET=hvac-documents

# --- Keycloak (via nginx path /auth on same host) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_STRONG
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=hvac
KEYCLOAK_CLIENT_ID=hvac-backend
# Must match docker/keycloak/hvac-realm.json hvac-backend secret unless you change the realm.
KEYCLOAK_CLIENT_SECRET=backend-secret-change-me
# If login returns 401 after Keycloak accepts password, decode JWT `iss` and set to match (hostname/proxy).
KEYCLOAK_TOKEN_ISSUER=
KEYCLOAK_FRONTEND_CLIENT_ID=hvac-frontend

# --- Backend ---
SECRET_KEY=CHANGE_ME_LONG_RANDOM
CORS_ORIGINS=["http://${PUBLIC_HOST}","http://localhost:3500"]
BACKEND_DEBUG=false
# First deploy on empty DB: set true once, restart backend, then false (same DDL as dev DEBUG).
SCHEMA_BOOTSTRAP_ON_STARTUP=false
DEV_BYPASS_AUTH=false
# Same key as in repo-root .env on your dev machine (AI assistant + Celery OpenAI tasks). Copy the value; do not commit it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: set both when using compose service xray-openai (OpenAI via VLESS, other sites direct in Xray).
# OPENAI_VLESS_URI=vless://...
# OPENAI_HTTP_PROXY=http://xray-openai:10808

# --- Git / admin deploy (compose service deploy-agent; mount DEPLOY_HOST_REPO_PATH) ---
# Private deploy key (PEM). Use \n for newlines in a single line if needed.
GITHUB_SSH_KEY=
GITHUB_REPO_URL=git@github.com:YOUR_ORG/YOUR_REPO.git
# Host path to this repo on the server (same tree as compose files).
DEPLOY_HOST_REPO_PATH=/opt/crm
# Backend talks to deploy-agent on the Docker network.
DEPLOY_AGENT_URL=http://deploy-agent:9090
ADMIN_DEPLOY_ENABLED=true
# Optional: docker compose -p name
COMPOSE_PROJECT_NAME=

# --- Frontend (build/runtime) ---
BACKEND_INTERNAL_URL=http://backend:8000
# Leave empty so the browser uses same-origin /api/v1 (works behind nginx on any host/IP).
# Only set to full public URL if API is on another origin (never use a LAN IP for external users).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_KEYCLOAK_URL=http://${PUBLIC_HOST}/auth
NEXT_PUBLIC_KEYCLOAK_REALM=hvac
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=hvac-frontend
NEXTAUTH_URL=http://${PUBLIC_HOST}
NEXTAUTH_SECRET=CHANGE_ME_RANDOM

# Optional maps key
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
