# Copy fragments into repo-root .env when exposing Docker nginx:80 via ngrok / Cloudflare Tunnel.
# Replace PUBLIC_HOST with your tunnel hostname (no trailing slash), e.g. abc123.ngrok-free.app
#
# Auth: localStorage JWT is per-origin. After opening the tunnel URL you MUST log in again —
# the session from http://localhost:3500 does not apply to https://PUBLIC_HOST.
#
# 1) One tunnel to port 80 (stack: nginx + frontend + /api + /auth + /ws).
# 2) CORS: browser origin must be allowed for any direct API calls (same-origin /api via Next is OK).
# 3) MinIO presigned URLs: use nginx path /storage-s3 (see docker/nginx/nginx.conf) so files open in the browser.
# 4) Keycloak: add redirect URIs for https://PUBLIC_HOST/* if realm import was already applied (or re-import realm).

# PUBLIC_HOST=abc123.ngrok-free.app

# CORS_ORIGINS=["https://PUBLIC_HOST","http://localhost:3500"]
# MINIO_PUBLIC_ENDPOINT=https://PUBLIC_HOST/storage-s3

# Optional: force WS / Keycloak base if you do not use same-origin defaults
# NEXT_PUBLIC_WS_URL=
# NEXT_PUBLIC_KEYCLOAK_URL=https://PUBLIC_HOST/auth
